# ---- Panel ----
MON_HOST=0.0.0.0
MON_PORT=8090
MON_USER=admin
MON_PASS=ganti-password-ini
MON_WIDGET_TOKEN=ganti-token-acak-24-byte

# ---- Tombol shutdown (nonaktif secara default) ----
MON_POWER_ENABLED=0
# MON_POWER_PASS=password-khusus-shutdown
# MON_POWER_DELAY=30

# ---- Docker saja (abaikan bila jalan langsung di host) ----
# PROC_ROOT=/host/proc
# SYS_ROOT=/host/sys
# FS_ROOT_PREFIX=/host/root
# CUPS_SERVER=127.0.0.1:631
